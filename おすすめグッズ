/**
 * ランダムに1つ選んで表示する
 */
function displayRandomRecommend() {
    const containers = document.querySelectorAll('.rakuten-banner-sidebar, .rakuten-banner-center');
    if (containers.length === 0) return;

    // ランダムに1つ選ぶ
    const randomIndex = Math.floor(Math.random() * RECOMMEND_ITEMS.length);
    const selectedItem = RECOMMEND_ITEMS[randomIndex];

    containers.forEach(container => {
        container.innerHTML = selectedItem.html;
    });
}

// ページ読み込み時に実行
document.addEventListener('DOMContentLoaded', displayRandomRecommend);
